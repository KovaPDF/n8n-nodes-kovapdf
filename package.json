{
	"name": "n8n-nodes-kovapdf",
	"version": "0.1.1",
	"description": "Send PDFs for signature, follow them, download the signed file and verify PDF signatures with KovaPDF",
	"license": "MIT",
	"homepage": "https://www.kovapdf.com/developers",
	"keywords": [
		"n8n-community-node-package",
		"kovapdf",
		"pdf",
		"e-signature",
		"signature"
	],
	"author": {
		"name": "KovaPDF",
		"email": "support@kovapdf.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/KovaPDF/n8n-nodes-kovapdf.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/KovaPdfApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/KovaPdf/KovaPdf.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "10.14.0",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
